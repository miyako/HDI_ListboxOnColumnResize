{
	"destination": "detailScreen",
	"windowMinWidth": 420,
	"windowMaxWidth": 1200,
	"windowMinHeight": 400,
	"width": 720,
	"height": 540,
	"markerHeader": 15,
	"markerBody": 200,
	"markerBreak": 220,
	"markerFooter": 240,
	"events": [
		"onLoad",
		"onResize"
	],
	"method": "method.4dm",
	"pageFormat": {
		"paperName": "US Letter",
		"paperWidth": "612pt",
		"paperHeight": "792pt"
	},
	"pages": [
		{
			"objects": {
				"Tab Control": {
					"type": "tab",
					"top": 20,
					"left": 20,
					"width": 680,
					"height": 500,
					"sizingX": "grow",
					"sizingY": "grow",
					"dataSource": "TabControl",
					"dataSourceTypeHint": "arrayText",
					"labels": [
						"Page 1",
						"Page 2"
					],
					"action": "gotoPage",
					"events": [
						"onClick"
					]
				}
			}
		},
		{
			"objects": {
				"LB0": {
					"type": "listbox",
					"top": 240,
					"left": 40,
					"width": 640,
					"height": 260,
					"sizingX": "grow",
					"sizingY": "grow",
					"hideFocusRing": true,
					"rowHeight": "20px",
